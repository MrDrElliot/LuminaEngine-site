---
interface Props {
  notFound?: boolean;
}

const { notFound = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f5" />
    {notFound && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Documentation Coming Soon | Lumina Engine</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f7f7f5;
        color: #1e2422;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
      }

      main {
        display: grid;
        min-height: 100vh;
        min-height: 100svh;
        place-items: center;
        padding: 2rem;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.5rem, 7vw, 5.5rem);
        font-weight: 550;
        letter-spacing: -0.055em;
        line-height: 1.05;
        text-align: center;
        text-wrap: balance;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Documentation Coming Soon</h1>
    </main>
  </body>
</html>
