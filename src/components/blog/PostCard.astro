---
import type { BlogPost } from '../../lib/blog';
import { postHref } from '../../lib/blog';
import PostMeta from './PostMeta.astro';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const href = postHref(post);
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  {featured && <p class="post-card__flag">Latest</p>}
  <h2 class="post-card__title"><a href={href}>{post.data.title}</a></h2>
  <PostMeta
    date={post.data.date}
    authors={post.data.authors}
    tags={post.data.tags}
    version={post.data.version}
  />
  <p class="post-card__description">{post.data.description}</p>
  {post.data.draft && <p class="post-card__draft">Draft</p>}
</article>

<style>
  .post-card {
    padding-block: 1.75rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .post-card--featured {
    padding: 1.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
  }

  .post-card__flag {
    margin: 0 0 0.5rem;
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-card__title {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-h4);
    line-height: 1.3;
  }

  .post-card--featured .post-card__title {
    font-size: var(--sl-text-h3);
  }

  .post-card__title a {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .post-card__title a:hover {
    color: var(--sl-color-accent-high);
  }

  .post-card__description {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-2);
    line-height: 1.7;
  }

  .post-card__draft {
    margin: 0.75rem 0 0;
    color: var(--sl-color-orange-high, var(--sl-color-gray-3));
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
  }
</style>
